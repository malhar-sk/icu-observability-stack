# Device agent configuration. Load it into the shell, then start the agent:
#   set -a; . agent/device-agent.env.example; set +a
#   python agent/device_agent.py
# Command-line flags (--device-id, --endpoint, --interval, --disk-path) override these.

# Unique, stable id for this device: lowercase letters, digits, '.', '_', '-'
# (max 63 chars, must start with a letter or digit). Default: lowercased hostname.
# Running several agents on one machine? Give each one its own value.
DEVICE_ID=demo-pi-1

# Collector address as host:port (plaintext gRPC).
OTLP_ENDPOINT=localhost:4317

# Seconds between pushes.
PUSH_INTERVAL=5

# Filesystem whose usage is reported as device_disk_utilization_percent.
DISK_PATH=/
