# ---------------------------------------------------------------- output
def _style(text, code):
    if sys.stdout.isatty() and "NO_COLOR" not in os.environ:
        return f"\033[{code}m{text}\033[0m"
    return text


def green(t): return _style(t, "32")
def red(t): return _style(t, "31")
def yellow(t): return _style(t, "33")
def dim(t): return _style(t, "2")
def bold(t): return _style(t, "1")
def tick(): return green("✓" if UTF8 else "ok")
def cross(): return red("✗" if UTF8 else "x")


def fmt_age(seconds):
    s = int(max(0, seconds))
    if s < 60:
        return f"{s}s"
    m, s = divmod(s, 60)
    if m < 60:
        return f"{m}m {s:02d}s"
    h, m = divmod(m, 60)
    if h < 24:
        return f"{h}h {m:02d}m"
    d, h = divmod(h, 24)
    return f"{d}d {h}h"


def fmt_pct(v): return "-" if v is None else f"{v:.1f}%"
def fmt_temp(v): return "-" if v is None else f"{v:.1f}C"
def fmt_dur(v): return "-" if v is None else fmt_age(v)


def table(headers, rows, style_cell=None):
    """Print a left-aligned table. Widths come from plain text, so colours never break alignment."""
    widths = [max([len(h)] + [len(r[i]) for r in rows]) for i, h in enumerate(headers)]
    last = len(widths) - 1
    print("  " + "  ".join(dim(h if i == last else h.ljust(w)) for i, (h, w) in enumerate(zip(headers, widths))))
    for r in rows:
        cells = []
        for i, (c, w) in enumerate(zip(r, widths)):
            padded = c if i == last else c.ljust(w)  # no trailing spaces after the last column
            cells.append(style_cell(i, c, padded) if style_cell else padded)
        print("  " + "  ".join(cells))


def confirm(prompt, assume_yes=False, word=None):
    """Ask before anything destructive. With `word`, the user must type that word."""
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        raise FleetError("this needs your confirmation and there is no terminal to ask on; re-run with --yes")
    answer = input(f"{prompt} ").strip().lower()
    return answer == word if word else answer in ("y", "yes")


# ---------------------------------------------------------------- talking to the stack
_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # local services: never via a proxy


def http(method, url, data=None, auth=None, timeout=10, headers=None):
    req = urllib.request.Request(url, data=data, method=method)
    for key, value in (headers or {}).items():
        req.add_header(key, value)
    if auth:
        req.add_header("Authorization", "Basic " + base64.b64encode(auth.encode()).decode())
    try:
        with _OPENER.open(req, timeout=timeout) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()
    except (urllib.error.URLError, OSError) as e:
        raise FleetError(f"cannot reach {url}: {getattr(e, 'reason', e)}")


def vm_healthy():
    try:
        status, body = http("GET", VM_URL + "/health", timeout=3)
    except FleetError:
        return False
    return status == 200 and body.strip() == b"OK"


def grafana_healthy():
