# ---------------------------------------------------------------- MQTT input (optional)
# The settings live in .env, which Docker Compose reads by itself: COMPOSE_PROFILES switches the MQTT services on,
# the MQTT_* values tell the bridge (and the bundled broker) where to connect and how to log in.
def read_env():
    values = {}
    try:
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, _, val = line.partition("=")
                    values[key.strip()] = val.strip().strip("'\"")
    except FileNotFoundError:
        pass
    return values


def env_quote(value):
    if re.fullmatch(r"[A-Za-z0-9_.:/@%+,=-]*", value):
        return value
    if any(c in value for c in "'\n\r\0"):
        raise FleetError("a value for .env may not contain a quote, a line break or a NUL character")
    return f"'{value}'"  # single quotes: Docker Compose then takes it literally ($ and spaces included)


def write_env(updates):
    """Change only the given keys in .env (None removes one); every other line is kept. Private to the owner."""
    try:
        with open(ENV_FILE) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = ["# Written by ./fleet. Holds the MQTT and watcher settings; the MQTT password is a secret: do not share or commit this file."]
    done, out = set(), []
    for line in lines:
        key = line.partition("=")[0].strip() if "=" in line and not line.lstrip().startswith("#") else None
        if key in updates:
            done.add(key)
            if updates[key] is not None:
                out.append(f"{key}={env_quote(updates[key])}")
        else:
            out.append(line)
    out += [f"{k}={env_quote(v)}" for k, v in updates.items() if k not in done and v is not None]
    tmp = ENV_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(out) + "\n")
    os.replace(tmp, ENV_FILE)


def mqtt_mode(env=None):
    """'bundled' (our broker), 'external' (a broker you already run) or None (MQTT is off)."""
    profiles = (env if env is not None else read_env()).get("COMPOSE_PROFILES", "").split(",")
    return "bundled" if "mqtt" in profiles else "external" if "mqtt-bridge" in profiles else None


def other_profiles(env):
    return [p for p in env.get("COMPOSE_PROFILES", "").split(",") if p and p not in ("mqtt", "mqtt-bridge")]


def parse_broker(value):
    """'host' or 'host:port' -> (host, port). Not a loopback address: inside the bridge's container that is the container."""
    host, port = value.strip(), None
    if host.count(":") == 1:
        host, _, port = host.partition(":")
    try:
        number = int(port) if port is not None else MQTT_PORT  # "host:" is a typo, not "the default port"
    except ValueError:
        number = 0
    if not HOST_RE.fullmatch(host) or not 0 < number < 65536:
        raise FleetError(f"invalid broker address {value!r}: use HOST or HOST:PORT (a name or an IPv4 address)")
    if host.lower() == "localhost" or host.startswith("127.") or host == "0.0.0.0":
        raise FleetError(f"'{host}' would point at the bridge's own container. Use the address other machines "
                         "use to reach that broker (for example 192.168.1.20).")
    return host, number


def apply_mqtt_args(args):
    """Write the MQTT choice from `up --mqtt / --mqtt-broker / --no-mqtt` into .env. True when something was asked."""
    if args.mqtt_user and not args.mqtt_broker:
        raise FleetError("--mqtt-user goes with --mqtt-broker (the bundled broker's user is created for you)")
    env = read_env()
    keep = other_profiles(env)
    if args.mqtt:
        password = env.get("MQTT_PASSWORD") if mqtt_mode(env) == "bundled" and env.get("MQTT_PASSWORD") else secrets.token_hex(12)
        write_env({"COMPOSE_PROFILES": ",".join(keep + ["mqtt"]), "MQTT_USERNAME": "fleet", "MQTT_PASSWORD": password,
                   "MQTT_HOST": None, "MQTT_PORT": None})
    elif args.mqtt_broker:
        host, port = parse_broker(args.mqtt_broker)
        user = args.mqtt_user or ""
        password = ""
        if user:
            password = os.environ.get("FLEET_MQTT_PASSWORD") or ""
            if not password and sys.stdin.isatty():
                password = getpass.getpass(f"Password for '{user}' on {host}:{port} (input is hidden): ")
            if not password:
                raise FleetError("the broker password is needed: set FLEET_MQTT_PASSWORD, or run this in a terminal "
                                 "to be asked (it is never taken from the command line)")
        was_bundled = mqtt_mode(env) == "bundled"
        write_env({"COMPOSE_PROFILES": ",".join(keep + ["mqtt-bridge"]), "MQTT_HOST": host, "MQTT_PORT": str(port),
                   "MQTT_USERNAME": user, "MQTT_PASSWORD": password})
        if was_bundled and subprocess.run(["docker", "compose", "--profile", "*", "rm", "-sf", "mosquitto"],
                                          cwd=ROOT, capture_output=True).returncode:
            raise FleetError("could not stop the bundled broker; see: docker compose --profile '*' ps")
    elif args.no_mqtt:
        write_env({"COMPOSE_PROFILES": ",".join(keep) or None, "MQTT_HOST": None, "MQTT_PORT": None,
                   "MQTT_USERNAME": None, "MQTT_PASSWORD": None})
        if subprocess.run(["docker", "compose", "--profile", "*", "rm", "-sf", "mosquitto", "mqtt-bridge"],
                          cwd=ROOT, capture_output=True).returncode:
            raise FleetError("could not stop the MQTT services; see: docker compose --profile '*' ps")
    else:
        return False
    return True


# ---------------------------------------------------------------- watching things that cannot run the agent (optional)
# `./fleet watch add` keeps the list in ./watch/targets.json and turns the `watch` compose profile on in .env; the
# watcher container re-reads the file by itself, so adding or removing a target needs no restart.
_WATCHER_MODULE = []


def watcher_module():
    """watcher/watcher.py, loaded by path: the very file that runs in the container, so the CLI and the service
    validate a target by the same rules."""
    if not _WATCHER_MODULE:
        spec = importlib.util.spec_from_file_location("fleet_watcher", os.path.join(ROOT, "watcher", "watcher.py"))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        _WATCHER_MODULE.append(module)
    return _WATCHER_MODULE[0]


def watch_enabled(env=None):
    return "watch" in (env if env is not None else read_env()).get("COMPOSE_PROFILES", "").split(",")


def read_targets():
    try:
        with open(TARGETS_FILE) as f:
            doc = json.load(f)
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as exc:
        raise FleetError(f"{TARGETS_FILE} cannot be read ({exc}). Fix it, or delete it to start the list again.")
    targets = doc.get("targets") if isinstance(doc, dict) else None
    if not isinstance(targets, list):
        raise FleetError(f"{TARGETS_FILE} is not a target list. Fix it, or delete it to start the list again.")
    return [t for t in targets if isinstance(t, dict)]


def write_targets(targets):
    try:
        os.makedirs(WATCH_DIR, exist_ok=True)
        tmp = TARGETS_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"version": 1, "targets": targets}, f, indent=2)
            f.write("\n")
        os.chmod(tmp, 0o644)  # the container runs as another user without special rights: it must be able to read this
        os.replace(tmp, TARGETS_FILE)
    except OSError as exc:
        raise FleetError(f"cannot write {TARGETS_FILE}: {exc}. If Docker created the 'watch' folder itself, "
                         "remove it (sudo rm -r watch) and try again.")


def set_watch_profile(on):
    env = read_env()
    profiles = [p for p in env.get("COMPOSE_PROFILES", "").split(",") if p and p != "watch"]
    write_env({"COMPOSE_PROFILES": ",".join(profiles + (["watch"] if on else [])) or None})


def start_watcher():
    """Turn the watcher on (remembered in .env) and start it if it is not already running."""
    set_watch_profile(True)
    if compose_ps().get("watcher") == "running":
        return
    if subprocess.run(["docker", "image", "inspect", WATCHER_IMAGE], capture_output=True).returncode:
        print(f"First time: downloading a small Python image ({WATCHER_IMAGE}, about 70 MB on disk) for the watcher.")
    if subprocess.run(["docker", "compose", "up", "-d", "watcher"], cwd=ROOT).returncode:
        raise FleetError("could not start the watcher; see the output above.")


def watch_failure(device_id):
    """What the watcher last said about this target if it is DOWN; None when it is UP or has not been heard of."""
    r = compose("logs", "--no-log-prefix", "--tail", "200", "watcher", capture=True)
    said = None
    for line in r.stdout.splitlines():
        m = re.match(r"^\S+ \S+ (?:INFO|WARNING|ERROR) " + re.escape(device_id) + r": (UP|DOWN) \((.*)\)$", line)
        if m:
            said = m.group(2) if m.group(1) == "DOWN" else None
    return said


def _seconds(value):
    return int(value) if value is not None and value == int(value) else value


def cmd_watch_add(args):
    require_docker()
    require_stack()
    raw = {"id": args.device_id, "kind": args.kind, "target": args.target}
    for key, value in (("interval", _seconds(args.interval)), ("timeout", _seconds(args.timeout)),
                       ("expect_status", args.expect_status), ("max_series", args.max_series)):
        if value is not None:
            raw[key] = value
    if args.insecure:
        raw["insecure"] = True
    try:
        spec = watcher_module().validate_target(raw)
    except ValueError as exc:
        raise FleetError(str(exc))
    device_id = spec["id"]
    targets = read_targets()
    if any(t.get("id") == device_id for t in targets):
        raise FleetError(f"'{device_id}' is already watched. See: ./fleet watch list   "
                         f"(to change it: ./fleet watch remove {device_id}, then add it again)")
    existing = fetch_devices().get(device_id)
    if existing and existing["state"] == "ONLINE":
        raise FleetError(f"'{device_id}' is already reporting (via {existing['via']}, last seen "
                         f"{fmt_age(existing['age_seconds'])} ago). Two devices with the same ID overwrite each other: pick another ID.")
    host = (urllib.parse.urlsplit(spec["target"]).hostname if spec["kind"] in ("http", "metrics")
            else spec["target"].rpartition(":")[0] if spec["kind"] == "tcp" else spec["target"])
    write_targets(targets + [spec])
    start_watcher()
    limit = offline_limit(spec["interval"])
    print(bold(f"Watching '{device_id}'") + f"   {spec['kind']} {spec['target']}, every {fmt_age(spec['interval'])}")
    print(f"  It counts as OFFLINE after {fmt_age(limit)} without an answer, and appears on the dashboard the first time it answers.")
    if host and host.lower().endswith(".local"):
        print(yellow(f"  Note: '{host}' is a .local name (mDNS). Docker containers usually cannot resolve those; "
                     "if it never answers, use the device's IP address instead."))
    if args.no_wait:
        return 0
    print()
    start = time.time()
    next_look = start + WATCH_FIRST_LOOK
    try:
        while time.time() < start + args.wait:
            d = fetch_devices().get(device_id)
            if d and d["state"] == "ONLINE":
                if sys.stdout.isatty():
                    print(f"\r{' ' * 78}\r", end="")
                print(f"{tick()} {bold(device_id)} answered after {int(time.time() - start)}s   See it: ./fleet check {device_id}")
                return 0
            if time.time() >= next_look:
                next_look = time.time() + WATCH_LOOK_EVERY
                reason = watch_failure(device_id)
                if reason:
                    if sys.stdout.isatty():
                        print(f"\r{' ' * 78}\r", end="")
                    print(yellow(f"Not answering: {reason}"))
                    print(f"  It stays on the list and appears here the moment it answers. A typo? "
                          f"./fleet watch remove {device_id}")
                    return 1
            if sys.stdout.isatty():
                print(f"\r  waiting for '{device_id}' to answer... {int(time.time() - start)}s (Ctrl+C to stop waiting)", end="", flush=True)
            time.sleep(POLL_SECONDS)
    except KeyboardInterrupt:
        print("\nStopped waiting. It will appear as soon as it answers.")
        return 0
    print(yellow(f"\nNo answer within {args.wait}s. It will appear as soon as it answers; to see why not: docker compose logs watcher"))
    return 1


