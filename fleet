VM_URL = os.environ.get("FLEET_VM_URL", "http://localhost:8428").rstrip("/")
GRAFANA_URL = os.environ.get("FLEET_GRAFANA_URL", "http://localhost:3000").rstrip("/")
GRAFANA_AUTH = os.environ.get("FLEET_GRAFANA_AUTH", "admin:admin")
OTLP_PORT = 4317
OFFLINE_AFTER = 30  # seconds without a sample; the same rule the dashboard and the alert use
LOOKBACK = "1d"     # a device silent for longer drops out of every view
POLL_SECONDS = 2.0
READINGS = (
    ("cpu", "device_cpu_utilization_percent"),
    ("mem", "device_memory_utilization_percent"),
