    print(f"  temperature {fmt_temp(d['temp']) if d['temp'] is not None else '- (no sensor, or not reported)'}")
    print(f"  uptime      {fmt_dur(d['uptime'])}")
    if d["state"] == "OFFLINE":
        print()
        print(f"  No data for {fmt_age(d['age_seconds'])}. Check the device's power, network and agent. "
              f"If it is retired: ./fleet remove {d['device_id']}")
    return 0


def agent_path(name):
    p = os.path.join(ROOT, "agent", name)
    rel = os.path.relpath(p)
    return p if rel.startswith("..") else rel


def wait_for_device(device_id, timeout):
    """Poll until the device reports. True when it does, False on timeout."""
    deadline = time.time() + timeout
    start = time.time()
    while time.time() < deadline:
        d = fetch_devices().get(device_id)
        if d and d["state"] == "ONLINE":
            if sys.stdout.isatty():
                print(f"\r{' ' * 78}\r", end="")  # wipe the "waiting..." line
            readings = [f"{n} {f(d[k])}" for n, k, f in (("CPU", "cpu", fmt_pct), ("memory", "mem", fmt_pct), ("temp", "temp", fmt_temp))
                        if d[k] is not None]
            print(f"{tick()} {bold(device_id)} is online after {int(time.time() - start)}s "
                  f"{dim('(' + (', '.join(readings) or 'via ' + d['via']) + ')')}")
            return True
        if sys.stdout.isatty():
            print(f"\r  waiting for '{device_id}' to report... {int(time.time() - start)}s (Ctrl+C to stop waiting)", end="", flush=True)
        time.sleep(POLL_SECONDS)
    print()
    return False


def cmd_add_mqtt(args, existing):
    mode = mqtt_mode()
    if not mode:
        raise FleetError("MQTT is not turned on. Start it with: ./fleet up --mqtt   "
                         "(or ./fleet up --mqtt-broker HOST to use a broker you already run)")
    env = read_env()
    if mode == "bundled":
        host, port = args.host or lan_ip() or "localhost", MQTT_PORT
        user, password = env.get("MQTT_USERNAME", "fleet"), env.get("MQTT_PASSWORD", "")
    else:
        host, port = args.host or env.get("MQTT_HOST", ""), env.get("MQTT_PORT", str(MQTT_PORT))
        user, password = env.get("MQTT_USERNAME", ""), "<your broker password>"
    dev = args.device_id
    auth = (f" -u {user} -P '{password}'" if user else "")
    pub = f"mosquitto_pub -h {host} -p {port}{auth}"
    print(bold(f"Add device '{dev}' over MQTT"))
    if existing:
        print(yellow(f"  Note: '{dev}' reported before (offline for {fmt_age(existing['age_seconds'])}). "
                     "If this is the same device, just start it again."))
    print()
    print(f"  Broker     {host}:{port}   {dim('plain MQTT, no encryption: keep it on a network you trust')}")
    if user:
        print(f"  User       {user}")
        print(f"  Password   {password}   {dim('shared by every device; treat it like a Wi-Fi password')}")
    print()
    print("  The device publishes plain numbers (21.5, not \"21.5C\" or JSON) to these topics:")
    print(f"       fleet/{dev}/uptime_seconds            REQUIRED: any number that keeps growing, e.g. seconds since boot")
    print(f"       fleet/{dev}/report_interval_seconds   how often it reports; it counts as OFFLINE after 3x this (min 30 s)")
    print(f"       fleet/{dev}/temperature_celsius       any other reading: humidity_percent, battery_volts, ...")
    print()
    print("  Try it from any computer that has the mosquitto clients installed:")
    print(f"       {pub} -t fleet/{dev}/report_interval_seconds -m 60 -r")
    print(f"       {pub} -t fleet/{dev}/uptime_seconds -m 1")
    print(f"       {pub} -t fleet/{dev}/temperature_celsius -m 21.5")
    print(dim("  Board examples (MicroPython, Arduino, Python): docs/MQTT.md"))
    if mode == "bundled" and host != "localhost" and not args.host:
        print(dim(f"  If this machine's address ({host}) can change (DHCP, phone hotspot), devices will stop "
                  "reporting; reserve the address in your router, or pass --host with a stable name."))
    if args.no_wait:
        return 0
    print()
    try:
        if wait_for_device(dev, args.timeout):
            print(f"  See it: ./fleet check {dev}")
            return 0
    except KeyboardInterrupt:
        print("\nStopped waiting. The device will still appear as soon as it reports.")
        return 0
    print(yellow(f"Gave up waiting after {args.timeout}s. It will still appear once it reports."))
    print("  Not showing up? Check the bridge:  docker compose logs mqtt-bridge   (it names bad topics and values)")
    return 1


