    {
      "id": 3,
      "type": "table",
      "title": "Fleet (one row per device_id)",
      "description": "ONLINE/OFFLINE: age = time() - tlast_over_time(device_uptime_seconds[1d]); OFFLINE when age > 30 s. Last seen is the timestamp of the newest device_uptime_seconds sample. Readings are the last sample from the past minute; N/A means no current sample (sensor not present, or device offline).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "topk by (device_id) (1, tlast_over_time(device_uptime_seconds[1d])) * 1000",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (device_id) (time() - tlast_over_time(device_uptime_seconds[1d])) > bool 30",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (device_id) (last_over_time(device_cpu_utilization_percent[1m]))",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (device_id) (last_over_time(device_memory_utilization_percent[1m]))",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (device_id) (last_over_time(device_disk_utilization_percent[1m]))",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (device_id) (last_over_time(device_temperature_celsius[1m]))",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (device_id) (last_over_time(device_uptime_seconds[1m]))",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "device_id",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(device_id|hostname|Value #[A-G])$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "device_id": 0,
              "hostname": 1,
              "Value #B": 2,
              "Value #A": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8
            },
            "renameByName": {
              "Value #A": "last seen",
              "Value #B": "state",
              "Value #C": "CPU %",
              "Value #D": "memory %",
              "Value #E": "disk %",
              "Value #F": "temperature",
              "Value #G": "uptime"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
